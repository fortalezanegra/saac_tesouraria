/*===================================================
         TOTAL ENTRADA - TOTAL SAIDA - SALDO FINAL
===================================================*/

SELECT
    SUM(CASE 
            WHEN tp.descricao = 'ENTRADA' THEN l.valor 
            ELSE 0 
        END) AS total_entradas,

    SUM(CASE 
            WHEN tp.descricao = 'SAIDA' THEN l.valor 
            ELSE 0 
        END) AS total_saidas,

    SUM(CASE 
            WHEN tp.descricao = 'ENTRADA' THEN l.valor
            WHEN tp.descricao = 'SAIDA'   THEN -l.valor
            ELSE 0
        END) AS saldo_final
FROM Lancamento l
JOIN Categoria c ON c.categoriaId = l.categoriaId
JOIN TipoMovimentacao tp ON tp.tipoMovimentacaoId = c.tipoMovimentacaoId
WHERE l.deletedAt IS NULL
  AND l.livroCaixaId = $P{LIVRO_CAIXA_ID};



/*===================================================
            TOTAL POR CENTRO DE CUSTO - ENTRADA
===================================================*/

SELECT
    cc.centroCustoId,
    cc.descricao AS centroCusto,
    SUM(l.valor) AS total_entradas
FROM Lancamento l
JOIN Categoria c ON c.categoriaId = l.categoriaId
JOIN TipoMovimentacao tp ON tp.tipoMovimentacaoId = c.tipoMovimentacaoId
JOIN CentroCusto cc ON cc.centroCustoId = l.centroCustoId
WHERE l.deletedAt IS NULL
  AND l.livroCaixaId = $P{LIVRO_CAIXA_ID}
  AND tp.descricao = 'ENTRADA'
GROUP BY cc.centroCustoId, cc.descricao
ORDER BY cc.descricao;

/*===================================================
            TOTAL POR CENTRO DE CUSTO - SAIDA
===================================================*/

SELECT
    cc.centroCustoId,
    cc.descricao AS centroCusto,
    SUM(l.valor) AS total_entradas
FROM Lancamento l
JOIN Categoria c ON c.categoriaId = l.categoriaId
JOIN TipoMovimentacao tp ON tp.tipoMovimentacaoId = c.tipoMovimentacaoId
JOIN CentroCusto cc ON cc.centroCustoId = l.centroCustoId
WHERE l.deletedAt IS NULL
  AND l.livroCaixaId = $P{LIVRO_CAIXA_ID}
  AND tp.descricao = 'ENTRADA'
GROUP BY cc.centroCustoId, cc.descricao
ORDER BY cc.descricao;


/*===================================================
TOTAL POR CENTRO DE CUSTO - ENTRADA/SAIDA/SALDO FINAL
===================================================*/

SELECT
    cc.centroCustoId,
    cc.descricao AS centroCusto,

    SUM(CASE
            WHEN tp.descricao = 'ENTRADA' THEN l.valor
            ELSE 0
        END) AS total_entradas,

    SUM(CASE
            WHEN tp.descricao = 'SAIDA' THEN l.valor
            ELSE 0
        END) AS total_saidas,

    SUM(CASE
            WHEN tp.descricao = 'ENTRADA' THEN l.valor
            WHEN tp.descricao = 'SAIDA'   THEN -l.valor
            ELSE 0
        END) AS saldo
FROM Lancamento l
JOIN Categoria c ON c.categoriaId = l.categoriaId
JOIN TipoMovimentacao tp ON tp.tipoMovimentacaoId = c.tipoMovimentacaoId
JOIN CentroCusto cc ON cc.centroCustoId = l.centroCustoId
WHERE l.deletedAt IS NULL
  AND l.livroCaixaId = $P{LIVRO_CAIXA_ID}
GROUP BY cc.centroCustoId, cc.descricao
ORDER BY cc.descricao;


/*========================================================================
TOTAL ENTRADAS - TOTAL SAIDAS - SALDO FINAL - SALDO ENVIADO - SALDO ENVIAR
========================================================================*/

SELECT
    /* TOTAL ENTRADAS */
    SUM(CASE
            WHEN tm.descricao = 'ENTRADA' THEN l.valor
            ELSE 0
        END) AS total_entradas,

    /* TOTAL SAIDAS */
    SUM(CASE
            WHEN tm.descricao = 'SAIDA' THEN l.valor
            ELSE 0
        END) AS total_saidas,

    /* SALDO FINAL = ENTRADA - SAIDA */
    SUM(CASE
            WHEN tm.descricao = 'ENTRADA' THEN l.valor
            WHEN tm.descricao = 'SAIDA'   THEN -l.valor
            ELSE 0
        END) AS saldo_final,

    /* SALDO ENVIADO (ENTRADA + MATRIZ + PAGAMENTO != DINHEIRO) */
    SUM(CASE
            WHEN tm.descricao = 'ENTRADA'
             AND cc.tipoCentro = 'Matriz'
             AND tp.descricao <> 'Dinheiro'
                THEN l.valor
            ELSE 0
        END) AS saldo_enviado,

    /* SALDO A ENVIAR = SALDO FINAL - SALDO ENVIADO */
    (
        SUM(CASE
                WHEN tm.descricao = 'ENTRADA' THEN l.valor
                WHEN tm.descricao = 'SAIDA'   THEN -l.valor
                ELSE 0
            END)
        -
        SUM(CASE
                WHEN tm.descricao = 'ENTRADA'
                 AND cc.tipoCentro = 'Matriz'
                 AND tp.descricao <> 'Dinheiro'
                    THEN l.valor
                ELSE 0
            END)
    ) AS saldo_a_enviar

FROM Lancamento l
JOIN Categoria c 
    ON c.categoriaId = l.categoriaId
JOIN TipoMovimentacao tm 
    ON tm.tipoMovimentacaoId = c.tipoMovimentacaoId
JOIN CentroCusto cc 
    ON cc.centroCustoId = l.centroCustoId
JOIN TipoPagamento tp 
    ON tp.tipoPagamentoId = l.tipoPagamentoId
WHERE l.deletedAt IS NULL
  AND l.livroCaixaId = $P{LIVRO_CAIXA_ID};




